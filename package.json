{
    "name": "@_apparatus_/mfe-tools",
    "description": "Plugin and runtime tools for building ECMAScript module-based micro-frontends (MFEs).",
    "version": "4.0.1",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pedro00dk/apparatus-mfe-tools"
    },
    "author": {
        "name": "Pedro Henrique",
        "email": "pedro00dk@gmail.com"
    },
    "types": "dist/index.d.ts",
    "keywords": [
        "micro-frontend",
        "microfrontend",
        "mfe",
        "module",
        "federation",
        "vite",
        "plugin",
        "ECMAScript"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./plugin": {
            "import": "./dist/plugin.js",
            "types": "./dist/plugin.d.ts"
        }
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "magic-string": "0.30.21",
        "typescript": "7.0.2",
        "vite": "8.1.4"
    },
    "peerDependencies": {
        "vite": "^8.0.0"
    },
    "scripts": {
        "build": "tsc && bun build --outdir ./dist/ ./src/index.ts && bun build --target=node --external node:fs --outdir ./dist/ ./src/plugin.ts",
        "test": "bun test --pass-with-no-tests"
    }
}
